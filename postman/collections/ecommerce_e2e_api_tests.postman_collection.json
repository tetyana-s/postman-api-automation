    {
      "name": "Cart - Update cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Cart updated\", () => {",
              "  pm.response.to.have.status(200);",
              "  const cart = pm.response.json();",
              "  const item = cart.products.find(x => x.id === Number(pm.environment.get(\"productId\")));",
              "  pm.expect(item.quantity).to.eql(2);",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "PUT",
