    {
      "name": "Products - List/Search",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Products returned\", () => {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property(\"products\");",
              "  pm.expect(json.products).to.be.an(\"array\").that.is.not.empty;",
              "",
              "  pm.environment.set(\"productId\", json.products[0].id);",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/search?q=phone",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "phone"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Products - Get single product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Product details returned\", () => {",
              "  pm.response.to.have.status(200);",
              "  const p = pm.response.json();",
              "  pm.expect(p).to.have.property(\"id\");",
              "  pm.expect(String(p.id)).to.eql(String(pm.environment.get(\"productId\")));",
              "  pm.expect(p).to.have.property(\"price\");",
              "});",
