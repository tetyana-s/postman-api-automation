    {
      "name": "Users - Get current user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Authorized user profile returned\", () => {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property(\"id\");",
              "  pm.expect(String(json.id)).to.eql(String(pm.environment.get(\"userId\")));",
              "});",
