    {
      "name": "Cart - Create cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Cart created (201)\", () => {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "// Debug: see what came back",
              "console.log(\"Create cart response:\", json);",
              "",
              "pm.test(\"Cart response has id\", () => {",
              "  pm.expect(json).to.have.property(\"id\");",
              "});",
              "",
              "// Save cartId",
              "//pm.environment.set(\"cartId\", json.id);",
              "//Save cartId as a harcoded value since adding a new cart will not add it into the server",
              "pm.environment.set(\"cartId\", \"1\");",
              "",
              "pm.test(\"cartId saved to environment\", () => {",
              "  pm.expect(pm.environment.get(\"cartId\")).to.exist;",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": {{userId}},\n  \"products\": [\n    { \"id\": {{productId}}, \"quantity\": 1 }\n  ]\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/carts/add",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "carts",
            "add"
          ]
        }
      },
